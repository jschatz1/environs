{
  "name": "environs",
  "version": "0.1.0",
  "type": "module",
  "description": "A fine-grained reactive UI framework with zero ceremony",
  "main": "./dist/environs.js",
  "module": "./dist/environs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/environs.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:examples": "vite --config examples/vite.config.js"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
